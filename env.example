# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/hotel-management
MONGO_URI_LOCAL=mongodb://127.0.0.1:27017/hotel-management

# ── Frontend ──────────────────────────────────────────────────────────────────
# Vite dev server default. Must match exactly — it is used for CORS, for the
# post-login redirect, and as the base of every table QR code.
FRONTEND_URL=http://localhost:5173

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# https://console.cloud.google.com -> APIs & Services -> Credentials
# The callback URL is GLOBAL (one registered redirect URI for every restaurant);
# the tenant travels in the signed OAuth `state` parameter.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── JWT ───────────────────────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# ── Platform administrator (SUPER_ADMIN) ──────────────────────────────────────
# Seeded by `npm run seed`. This is the account that signs in at /platform and
# creates restaurants. It belongs to no restaurant.
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_EMAIL=you@example.com

# ── Optional: create one restaurant during seeding (handy for local dev) ───────
# Leave SEED_RESTAURANT_NAME blank to create restaurants from the console instead.
SEED_RESTAURANT_NAME=
SEED_RESTAURANT_SLUG=
SEED_RESTAURANT_TABLES=10
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=

# Set to 1 to skip seeding entirely on npm install
SKIP_SEED=

# ── Misc ──────────────────────────────────────────────────────────────────────
DEFAULT_DISH_IMAGE_URL=https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=400&q=70
GEMINI_API_KEY=
