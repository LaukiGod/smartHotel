# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI_LOCAL=mongodb://127.0.0.1:27017/hotel-management
MONGO_URI=mongodb://127.0.0.1:27017/hotel-management

SEED_ADMIN_NAME=Arjun Bam
SEED_ADMIN_EMAIL=acmearjun2003@gmail.com
SEED_ADMIN_ROLE=ADMIN

# ── STAFF ───────────────────────────────────────────────────────────────────────
# Inject first admin
DEFAULT_ADMIN_EMAIL=your_admin_email_here
DEFAULT_ADMIN_NAME=your_admin_name_here

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# Get these from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# ── Frontend ──────────────────────────────────────────────────────────────────
# Where to redirect after successful Google login
FRONTEND_URL=http://localhost:5173
DEFAULT_DISH_IMAGE_URL=https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=400&q=70

# Node environment
NODE_ENV=development

GEMINI_API_KEY=your_gemini_api_key_here
# Gemini-powered allergy checking is opt-in. Leave "false" (or unset) when no working
# GEMINI_API_KEY is available — allergy checks then run on the local synonym matcher only,
# so order placement never depends on Gemini being reachable.
ENABLE_GEMINI_ALLERGY_CHECK=false

RESTAURANT_SECRET=aaa